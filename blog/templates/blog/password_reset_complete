{% extends "blog/base.html" %}

{% block content %}
<div class="auth-page">
    <div class="auth-card">

        <div class="auth-card__logo">
            <div class="auth-card__logo-icon" style="background: var(--color-success);">&#10003;</div>
        </div>

        <h1 class="auth-card__title">Hasło zmienione!</h1>
        <p class="auth-card__subtitle">
            Twoje hasło zostało pomyślnie zmienione.
            Możesz się teraz zalogować.
        </p>

        <a href="{% url 'blog:login' %}" class="btn btn--primary btn--block btn--lg">
            Zaloguj się
        </a>

    </div>
</div>
{% endblock %}